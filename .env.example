# Copy to .env on the VPS (chmod 600). Never commit .env. Back it up with
# the other deployment secrets: losing the tokens means every client
# re-logs in; losing GIT_PASSWORD only means minting a new PAT.

# --- Index repository -------------------------------------------------------
INDEX_REPO_URL=https://github.com/wobletstudios/pesde-index.git
# A GitHub account with push access to the index. The password MUST be a
# fine-grained personal access token scoped to pesde-index only, with
# Contents: read and write. Set a calendar reminder for its expiry.
GIT_USERNAME=
GIT_PASSWORD=
# Committer shown on the index commits the registry makes
COMMITTER_GIT_NAME=woblet-registry
COMMITTER_GIT_EMAIL=

# --- Authentication: read/write tokens --------------------------------------
# Generate each with:  openssl rand -hex 32
# READ_ACCESS_TOKEN  - teammates and game CI (pesde install)
# WRITE_ACCESS_TOKEN - publishing only (your machine, luau-crate CI)
READ_ACCESS_TOKEN=
WRITE_ACCESS_TOKEN=

# --- Cloudflare Tunnel (prod profile only) ----------------------------------
# Connector token from Zero Trust > Networks > Tunnels > woblet-registry.
# Read by compose for the cloudflared service; never passed to the registry.
CF_TUNNEL_TOKEN=
